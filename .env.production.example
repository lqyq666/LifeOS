# Store on the server as .env.production, mode 0600; never include in source/archive.
# Database password: use 64 random hex characters (URL-safe).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
DASHSCOPE_API_KEY=
LIFEOS_MODEL_DEFAULT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional tier-specific override; blank falls back to DASHSCOPE_API_KEY.
LIFEOS_MODEL_DEFAULT_API_KEY=
LIFEOS_MODEL_REASONING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LIFEOS_MODEL_REASONING_API_KEY=
# Deep tier is disabled in V1.1 and is not configurable.
# CNY / million tokens. DeepSeek is priced at its Beijing busy-hour rate here for a conservative estimate.
LIFEOS_MODEL_PRICING_JSON='{"bailian:qwen3.8-flash":{"inputCnyPerMillion":0.8,"outputCnyPerMillion":2.7,"cachedInputCnyPerMillion":0.1},"bailian:deepseek-v4.1-flash":{"inputCnyPerMillion":2,"outputCnyPerMillion":8,"cachedInputCnyPerMillion":0.2}}'
LIFEOS_ORIGIN=https://lqynb.xyz
LIFEOS_HTTP_PORT=8787
# Small pilot starts with provisioned accounts. Public signup is an explicit setting.
LIFEOS_SIGNUP_ENABLED=false
# Resend Free: SMTP user "resend", password is a sending-only API key.
# Keep Free, paid overages disabled; application caps 80/24h and 900/31d.
LIFEOS_PASSWORD_RESET_ENABLED=false
LIFEOS_SMTP_HOST=smtp.resend.com
LIFEOS_SMTP_PORT=465
LIFEOS_SMTP_USER=resend
LIFEOS_SMTP_PASSWORD=
LIFEOS_MAIL_FROM=
LIFEOS_TRUSTED_PROXY=
LIFEOS_MESSAGES_PER_MINUTE=3
LIFEOS_MESSAGES_PER_DAY=50
# Deep Coze workflows stay disabled until the current candidate passes acceptance.
# The account ID must be the exact 32-character ID of a synthetic-only account.
LIFEOS_ADVANCED_WORKFLOWS=false
LIFEOS_REAL_WORKFLOWS=false
LIFEOS_COZE_GROWTH=false
LIFEOS_COZE_SYNTHETIC_USER_ID=
# Host file mounted read-only; keep its contents out of the repo and readable by container UID 1000.
LIFEOS_COZE_GROWTH_CONFIG_FILE=./deploy/coze-growth-config.unconfigured.json
