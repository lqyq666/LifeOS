{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["server", "scripts/*.ts", "tests/backend"],
  "exclude": [
    "tests/backend/campus-grounding-contract.test.ts",
    "tests/backend/campus-reference-context.test.ts",
    "tests/backend/campus-reliability.test.ts",
    "tests/backend/campus-repair.test.ts"
  ]
}

