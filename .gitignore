node_modules/
dist/
.env*
!.env.server.example
!.env.production.example
.local/
*.tsbuildinfo

# Acceptance evidence and exported handoffs are delivered separately from source.
/evidence/
/LifeOS-V1.1.1-HARD-GATE-STOP-20261002.zip
/LifeOS-V1.1-Phase2-Recovery-20261002.zip
/V1_1_NOT_ACCEPTED.md
/HANDOFF_V1_1_NOT_ACCEPTED.md
/LifeOS-V1.1.2-Cost-Slim-20261002.zip

# Generated local acceptance evidence stays outside version control.
# Preserve reviewed public source fixtures required by the offline tests.
/.planning/research/*/evidence/*
!/.planning/research/workflow-integration/evidence/public-card/
/.planning/research/workflow-integration/evidence/public-card/*
!/.planning/research/workflow-integration/evidence/public-card/candidate.json
!/.planning/research/workflow-integration/evidence/public-card/needs-review-candidate.json
!/.planning/research/workflow-integration/evidence/public-card/original.html
/.planning/research/**/*.log
/.planning/research/**/*.zip
/.planning/research/**/WORKFLOW_REAL_TRACES_*.json
/.planning/research/workflow-integration/probe-original.jsonl

# Python bytecode is local cache, never release content.
__pycache__/
*.py[cod]
