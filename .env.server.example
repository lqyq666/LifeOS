# Server only. Copy to .env.server; never use a VITE_ prefix for credentials.
DASHSCOPE_API_KEY=
# V1.1 模型固定为 qwen3.8-flash 与 deepseek-v4.1-flash。
LIFEOS_MODEL_DEFAULT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LIFEOS_MODEL_DEFAULT_API_KEY=
LIFEOS_MODEL_REASONING_API_KEY=
LIFEOS_MODEL_REASONING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional tier-specific keys override the shared server-side DASHSCOPE_API_KEY.
# CNY per million tokens. DeepSeek uses its official Beijing busy-hour rate for conservative estimates;
# actual billing may be lower during off-hours and may include context-cache discounts.
LIFEOS_MODEL_PRICING_JSON='{"bailian:qwen3.8-flash":{"inputCnyPerMillion":0.8,"outputCnyPerMillion":2.7,"cachedInputCnyPerMillion":0.1},"bailian:deepseek-v4.1-flash":{"inputCnyPerMillion":2,"outputCnyPerMillion":8,"cachedInputCnyPerMillion":0.2}}'
# Leave blank when using db:setup; it generates these values for the dedicated local database.
DATABASE_URL=
BETTER_AUTH_SECRET=
LIFEOS_ORIGIN=http://127.0.0.1:5173
LIFEOS_PORT=8787
